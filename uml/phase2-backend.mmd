  Player --> "1" PieceColor : color
  Move --> "2" Position : from, to
  Move --> "1..2" Piece : piece, captured
  Move --> "1" MoveType : type
  Move --> "1" PromotionPiece : promotion
  Board --> "0..32" Piece : grid, capturedPieces
  Piece --> "1" PieceColor : color
  Piece --> "1" Position : position
  Piece <|-- King
  Piece <|-- Queen
  Piece <|-- Rook
  Piece <|-- Bishop
  Piece <|-- Knight
  Piece <|-- Pawn
  Game --> "1" Board : board
  Game --> "2" Player : whitePlayer, blackPlayer
  Game --> "*" Move : moveHistory
  Game --> "*" GameListener : listeners
  Game --> "1" PieceColor : currentTurn
  Game --> "1" GameStatus : status
  MoveResult --> "1" Move : move
  Game ..> ChessRules : asks for legal moves
  ChessRules ..> Board : reads and copies
  ChessRules ..> Move : creates
  Board ..> PieceFactory : sets up pieces
  PromotionPiece ..> PieceFactory : creates promoted piece
  PieceFactory ..> Piece : creates
  Game ..> MoveResult : returns
